# ==============================================================================
# FINE DINE KNL RESTAURANT — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# For Render deployment, configure these key-value pairs in the Render Dashboard
# under Service Settings -> Environment Variables.
#
# DO NOT commit the .env file or real secrets to GitHub.
# ==============================================================================

# --- Server & Runtime ---
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# --- Persistent SQLite Storage ---
# In local development: leave empty to use server/knl_restaurant.db
# On Render Web Service with Persistent Disk: mount disk at /var/data and set:
DATABASE_PATH=/var/data/knl_restaurant.db

# --- Security & Authentication ---
# Generate a cryptographically secure random secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_strong_random_jwt_secret_token_here_minimum_32_characters

# --- Frontend & CORS Origins ---
# Set to your live public website domain on Render
CLIENT_URL=https://fine-dine-knl.onrender.com
# For multiple allowed origins, separate by comma:
CORS_ORIGIN=https://fine-dine-knl.onrender.com,http://localhost:4173

# --- Initial Admin Account (Seeded on first database startup) ---
# Once deployed, log in and change your password via My Account -> Security
ADMIN_EMAIL=admin@finedineknl.com
ADMIN_INITIAL_PASSWORD=YourStrongInitialAdminPassword2026!
ADMIN_PHONE=9490012345

# --- Frontend Build-Time API Target (Optional) ---
# ONLY required if deploying frontend as a separate Render Static Site.
# If deploying Unified Web Service (recommended), leave blank or unset.
# VITE_API_URL=https://fine-dine-knl-api.onrender.com

# --- Email / SMTP Dispatch Service (Optional) ---
# Used for sending real single-use password reset emails to customers
# Configure from Gmail, Brevo, SendGrid, Mailgun, or AWS SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FINE DINE KNL RESTAURANT" <noreply@finedineknl.com>

# --- Merchant Payment Gateway (Optional) ---
# Used for live Razorpay UPI and card payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
